# Prisma local development
PORT=3002
DATABASE_URL="postgresql://usuario:password@localhost:5432/mibasededatos"
AUTH_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend origins for local/dev and production
BACKEND_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# En Railway, usa URLs públicas completas con https://
# WEB_ORIGIN=https://tu-frontend.up.railway.app
# ADMIN_ORIGIN=https://tu-admin.up.railway.app
# CORS_ORIGINS=https://tu-frontend.up.railway.app,https://tu-admin.up.railway.app

# Credenciales por defecto del administrador para seed y login
# Ejemplo recomendado: email=admin@optica.com y password=Admin123!
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@optica.com
INITIAL_ADMIN_PASSWORD=Admin123!